#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        LeftMiddleClick {
            bindings = <&mkp MCLK>;
            key-positions = <37 38>;
        };

        arrowU {
            bindings = <&kp UP_ARROW>;
            key-positions = <39 38>;
        };

        arrowD {
            bindings = <&kp DOWN_ARROW>;
            key-positions = <53 52>;
        };

        MouseScrollLeft {
            bindings = <&msc SCRL_LEFT>;
            key-positions = <36 37 38>;
        };

        MouseScrollRight {
            bindings = <&msc SCRL_RIGHT>;
            key-positions = <38 39 40>;
        };

        arrowL {
            bindings = <&kp LEFT_ARROW>;
            key-positions = <52 51>;
        };

        arrowR {
            bindings = <&kp RIGHT_ARROW>;
            key-positions = <54 53>;
        };

        MouseScrollUPLeft {
            bindings = <&msc MOVE_Y(15)>;
            key-positions = <18 17 16>;
        };

        MouseScrollDownLeft {
            bindings = <&msc MOVE_Y(-15)>;
            key-positions = <32 31 30>;
        };

        MouseScrollRightLeft {
            bindings = <&msc SCRL_RIGHT>;
            key-positions = <31 32 33>;
        };
    };

    behaviors {
        /* ↓↓ これが tog_off の正体（設計図）です ↓↓ */

        tog_off: toggle_layer_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off"; /* ここが重要！「オフにする専用」の設定 */
        };
    };

    macros {
        MouseLeftMacro: MouseLeftMacro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mkp LCLK>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp LCLK>,
                <&macro_tap>,
                <&tog_off 2 &sl 2>;

            label = "MOUSELEFTMACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp GRAVE         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp ESCAPE   &kp EQUAL          &kp NUMBER_6   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0   &kp MINUS
&kp TAB           &kp Q         &kp W         &kp E         &kp R         &kp T         &kp F8       &kp RIGHT_BRACKET  &kp Y          &kp U         &kp I         &kp O         &kp P          &kp LEFT_BRACKET
&kp F6            &kp A         &kp S         &kp D         &kp F         &kp G         &kp F7       &kp NON_US_HASH    &kp H          &kp J         &kp K         &kp L         &kp SEMICOLON  &kp APOSTROPHE
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C         &kp V         &kp B         &mo 2        &kp B              &kp N          &kp M         &kp COMMA     &kp PERIOD    &kp SLASH      &kp INTERNATIONAL_1
&kp LEFT_CONTROL  &kp LEFT_GUI  &kp LEFT_ALT  &kp INT3      &kp TAB       &kp SPACE     &lt 1 ENTER  &lt 4 ENTER        &kp BACKSPACE                              &kp DELETE    &mo 3          &kp RIGHT_SHIFT
            >;
        };

        layer_1 {
            bindings = <
&kp GRAVE       &none           &none           &none           &none           &none            &none           &none            &none           &none            &kp KP_SLASH     &kp KP_SLASH     &kp KP_ASTERISK  &kp KP_MINUS
&kp TAB         &kp F2          &kp F6          &kp F7          &kp F8          &kp F10          &none           &none            &none           &none            &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS
&none           &none           &kp UP_ARROW    &none           &kp UP_ARROW    &none            &kp LG(PERIOD)  &kp RIGHT_SHIFT  &kp UP_ARROW    &none            &kp KP_N4        &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS
&kp LEFT_SHIFT  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp F5          &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp KP_N1        &kp KP_N2        &kp KP_NUMBER_3  &kp KP_ENTER
&kp LCTRL       &kp LEFT_GUI    &kp LEFT_ALT    &kp ENTER       &none           &kp SPACE        &none           &kp ENTER        &kp BACKSPACE                                     &kp KP_NUMBER_0  &kp KP_DOT       &kp KP_ENTER
            >;
        };

        layer_2 {
            bindings = <
&none           &none  &none  &none      &none     &none  &none  &none  &none     &none            &none      &none  &none  &none
&kp TAB         &none  &none  &none      &none     &none  &none  &none  &none     &none            &none      &none  &none  &none
&none           &none  &none  &mkp RCLK  &mkp MB1  &none  &none  &none  &none     &MouseLeftMacro  &mkp RCLK  &none  &none  &none
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C      &kp V     &none  &none  &none  &mkp MB4  &none            &none      &none  &none  &none
&kp LCTRL       &none  &none  &none      &none     &none  &none  &none  &none                                 &none  &none  &none
            >;
        };

        layer_3 {
            bindings = <
&none      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none  &none  &none  &none      &none          &none           &kp KP_SLASH    &kp KP_SLASH     &kp KP_MULTIPLY  &kp KP_MINUS
&none      &none         &none         &none         &none  &none  &none  &none      &none          &none           &kp KP_N7       &kp KP_N8        &kp KP_N9        &kp KP_PLUS
&none      &none         &none         &none         &none  &none  &none  &none      &none          &mkp LCLK       &kp UP_ARROW    &kp KP_N5        &kp KP_N6        &kp KP_PLUS
&none      &none         &none         &none         &none  &none  &none  &none      &none          &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp KP_NUMBER_3  &kp KP_ENTER
&kp LCTRL  &none         &none         &none         &none  &none  &none  &kp ENTER  &kp BACKSPACE                                  &kp KP_N0        &none            &kp KP_ENTER
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_SLASH  &kp KP_SLASH  &kp KP_MULTIPLY  &kp KP_MINUS
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_N7     &kp KP_N8     &kp KP_N9        &kp KP_PLUS
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_N4     &kp KP_N5     &kp KP_N6        &kp KP_PLUS
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_N1     &kp KP_N2     &kp KP_N3        &kp KP_ENTER
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                        &kp KP_N0     &kp KP_DOT       &kp KP_ENTER
            >;
        };
    };
};
